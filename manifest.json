{
  "manifest_version": 3,
  "name": "验证码自动识别助手",
  "version": "1.0.0",
  "description": "基于本地极速 OCR 引擎的全自动网页图形验证码识别与填充工具。0延迟、0干预、100%保护隐私，无缝为你省下每一次敲击键盘的时间。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "captchaAutoSolver",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
